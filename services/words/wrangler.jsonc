{
  "name": "guess-you-words",
  "account_id": "9b495f0be9f472aefa7c716c34820a32",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://guessyou.app,https://www.guessyou.app,http://127.0.0.1:8001,http://127.0.0.1:8011" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "guess-you-words",
    "database_id": "da15e7af-f57b-4d22-9c7d-6fb9f59d2385"
  }],
  "ratelimits": [{
    "name": "WORD_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
